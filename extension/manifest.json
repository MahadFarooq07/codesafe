{
  "manifest_version": 3,
  "name": "CodeSafe",
  "version": "1.0.0",
  "description": "Verification codes from Gmail, pasted in one tap. Read-only. Nothing leaves your browser.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeSafe",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["identity", "storage", "clipboardWrite", "alarms", "offscreen"],
  "host_permissions": ["https://gmail.googleapis.com/*"],
  "oauth2": {
    "client_id": "PASTE_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "commands": {
    "paste-latest-code": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Paste the latest verification code"
    }
  }
}
