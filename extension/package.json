{
  "name": "@codesafe/extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "CodeSafe Chrome extension (Manifest V3): verification codes from Gmail, pasted in one tap.",
  "scripts": {
    "build": "node ./build.mjs",
    "zip": "node ./build.mjs --zip",
    "release": "node ./build.mjs --release",
    "keygen": "node ./scripts/keygen.mjs",
    "test": "tsx test/extract.test.ts && tsx test/security.test.ts",
    "test:page": "node ./test/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "catalog:"
  }
}
