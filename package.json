{
  "name": "codesafe",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "ext:build": "pnpm --filter @codesafe/extension run build",
    "ext:zip": "pnpm --filter @codesafe/extension run zip",
    "ext:keygen": "pnpm --filter @codesafe/extension run keygen",
    "web:dev": "pnpm --filter @codesafe/web run dev",
    "video:dev": "pnpm --filter @codesafe/video run dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
